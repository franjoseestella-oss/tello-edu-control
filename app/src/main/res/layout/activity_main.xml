<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ===== Vídeo + detecciones ===== -->
    <SurfaceView
        android:id="@+id/surfaceVideo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.fran.tello.OverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Barra superior izquierda: logo + estado ===== -->
    <LinearLayout
        android:id="@+id/topLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/panel_glass"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:layout_margin="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="logo" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="220dp"
            android:layout_marginStart="8dp"
            android:text="Desconectado"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- ===== HUD de telemetría (centro-arriba) ===== -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/panel_glass"
        android:paddingHorizontal="6dp"
        android:paddingVertical="7dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/topLeft"
        app:layout_constraintEnd_toStartOf="@id/iconBar"
        app:layout_constraintHorizontal_bias="0.5">

        <TextView android:id="@+id/hudBattery" style="@style/HudValue" android:text="🔋 --%" />
        <TextView android:id="@+id/hudAlt" style="@style/HudValue" android:text="⛰ --" />
        <TextView android:id="@+id/hudSpeed" style="@style/HudValue" android:text="🚀 --" />
        <TextView android:id="@+id/hudTime" style="@style/HudValue" android:text="⏱ --" />
        <TextView android:id="@+id/hudTemp" style="@style/HudValue" android:text="🌡 --" />
        <TextView android:id="@+id/hudPad" style="@style/HudValue" android:text="🎯 --" />
    </LinearLayout>

    <!-- ===== Barra superior derecha: acciones ===== -->
    <LinearLayout
        android:id="@+id/iconBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/panel_glass"
        android:padding="4dp"
        android:layout_margin="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btnPhoto" style="@style/IconButton" android:text="📷" />
        <Button android:id="@+id/btnRecord" style="@style/IconButton" android:text="⏺" />
        <Button android:id="@+id/btnVoice" style="@style/IconButton" android:text="🎤" />
        <Button android:id="@+id/btnLog" style="@style/IconButton" android:text="📈" />
        <Button android:id="@+id/btnDebug" style="@style/IconButton" android:text="🐞" />
        <Button android:id="@+id/btnSettings" style="@style/IconButton" android:text="⚙" />
    </LinearLayout>

    <!-- ===== Modos de visión (fila glass, bajo el HUD) ===== -->
    <LinearLayout
        android:id="@+id/modeBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/panel_glass"
        android:paddingHorizontal="6dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/hud"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btnDetect" style="@style/ModeButton" android:text="👁 Caras" />
        <Button android:id="@+id/btnFollow" style="@style/ModeButton" android:text="🎯 Seguir" />
        <Button android:id="@+id/btnColor" style="@style/ModeButton" android:text="🟢 Color" />
        <Button android:id="@+id/btnGesture" style="@style/ModeButton" android:text="✋ Gestos" />
        <Button android:id="@+id/btnBody" style="@style/ModeButton" android:text="🦴 Cuerpo" />
        <Button android:id="@+id/btnEnroll" style="@style/ModeButton" android:text="➕ Cara" />
        <Button android:id="@+id/btnMission" style="@style/ModeButton" android:text="🗺 Misión" />
    </LinearLayout>

    <!-- ===== Joystick izquierdo ===== -->
    <com.fran.tello.JoystickView
        android:id="@+id/joyLeft"
        android:layout_width="165dp"
        android:layout_height="165dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        style="@style/HudValue"
        android:text="giro · altura"
        android:textSize="11sp"
        android:textColor="@color/text_dim"
        app:layout_constraintStart_toStartOf="@id/joyLeft"
        app:layout_constraintEnd_toEndOf="@id/joyLeft"
        app:layout_constraintBottom_toTopOf="@id/joyLeft" />

    <!-- ===== Joystick derecho ===== -->
    <com.fran.tello.JoystickView
        android:id="@+id/joyRight"
        android:layout_width="165dp"
        android:layout_height="165dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        style="@style/HudValue"
        android:text="mover"
        android:textSize="11sp"
        android:textColor="@color/text_dim"
        app:layout_constraintStart_toStartOf="@id/joyRight"
        app:layout_constraintEnd_toEndOf="@id/joyRight"
        app:layout_constraintBottom_toTopOf="@id/joyRight" />

    <!-- ===== Panel inferior central ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/panel_glass"
        android:padding="10dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnFlipL" style="@style/FlipButton" android:text="⟲" />
            <Button android:id="@+id/btnFlipF" style="@style/FlipButton" android:text="↑ Flip" />
            <Button android:id="@+id/btnFlipB" style="@style/FlipButton" android:text="↓ Flip" />
            <Button android:id="@+id/btnFlipR" style="@style/FlipButton" android:text="⟳" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button android:id="@+id/btnTakeoff" style="@style/PillOk" android:text="🛫 Despegar" />
            <Space android:layout_width="6dp" android:layout_height="1dp" />
            <Button android:id="@+id/btnLand" style="@style/PillPrimary" android:text="🛬 Aterrizar" />
            <Space android:layout_width="6dp" android:layout_height="1dp" />
            <Button android:id="@+id/btnEmergency" style="@style/PillDanger" android:text="🚨" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtSpeed"
            style="@style/HudValue"
            android:text="Velocidad: 50%"
            android:layout_marginTop="8dp" />
        <SeekBar
            android:id="@+id/seekSpeed"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />
    </LinearLayout>

    <!-- ===== Asistente de conexión (overlay) ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/connectOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_connect"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/panel_glass"
            android:padding="28dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tello Control"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/txtConnStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1. Conéctate al WiFi del dron (TELLO-XXXXXX)\n2. Pulsa Conectar"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="14dp" />

            <Button
                android:id="@+id/btnConnectBig"
                style="@style/PillPrimary"
                android:layout_width="match_parent"
                android:text="CONECTAR"
                android:textSize="17sp"
                android:layout_marginTop="20dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
