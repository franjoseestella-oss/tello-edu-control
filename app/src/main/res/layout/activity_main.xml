<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ===== Vídeo de la cámara (fondo) ===== -->
    <SurfaceView
        android:id="@+id/surfaceVideo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Capa de detecciones (recuadros de caras/gestos) ===== -->
    <com.fran.tello.OverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Botones de modo de visión ===== -->
    <LinearLayout
        android:id="@+id/modeBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btnVision" style="@style/ModeButton" android:text="👁 VISIÓN" />
        <Button android:id="@+id/btnFollow" style="@style/ModeButton" android:text="🎯 SEGUIR" />
        <Button android:id="@+id/btnGesture" style="@style/ModeButton" android:text="✋ GESTOS" />
        <Button android:id="@+id/btnEnroll"  style="@style/ModeButton" android:text="➕ CARA" />
    </LinearLayout>

    <!-- ===== Barra superior ===== -->
    <Button
        android:id="@+id/btnConnect"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:paddingHorizontal="16dp"
        android:text="CONECTAR"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/btn_conn"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desconectado"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:shadowColor="#000000"
        android:shadowRadius="6"
        app:layout_constraintTop_toTopOf="@id/btnConnect"
        app:layout_constraintBottom_toBottomOf="@id/btnConnect"
        app:layout_constraintStart_toEndOf="@id/btnConnect"
        android:layout_marginStart="12dp" />

    <TextView
        android:id="@+id/txtBattery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="🔋 --%"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:shadowColor="#000000"
        android:shadowRadius="6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnTakeoff"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:paddingHorizontal="20dp"
        android:text="🛫 DESPEGAR"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/btn_takeoff"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/txtBattery"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnLand"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:paddingHorizontal="20dp"
        android:text="🛬 ATERRIZAR"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/btn_land"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/btnTakeoff"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp" />

    <!-- ===== Mando IZQUIERDO: adelante/atrás/izquierda/derecha ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnForward"
            style="@style/DirButton"
            android:text="▲" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnLeft" style="@style/DirButton" android:text="◀" />
            <Space android:layout_width="72dp" android:layout_height="1dp" />
            <Button android:id="@+id/btnRight" style="@style/DirButton" android:text="▶" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBack"
            style="@style/DirButton"
            android:text="▼" />
    </LinearLayout>

    <!-- ===== Mando DERECHO: subir/bajar + girar ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnUp"
            style="@style/DirButton"
            android:text="⬆" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnYawLeft" style="@style/DirButton" android:text="↺" />
            <Space android:layout_width="72dp" android:layout_height="1dp" />
            <Button android:id="@+id/btnYawRight" style="@style/DirButton" android:text="↻" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDown"
            style="@style/DirButton"
            android:text="⬇" />
    </LinearLayout>

    <!-- ===== Velocidad ===== -->
    <LinearLayout
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/txtSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Velocidad: 50%"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowRadius="6" />

        <SeekBar
            android:id="@+id/seekSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
