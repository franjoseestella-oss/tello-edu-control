<resources>
    <!-- Botones de acción principales (píldoras) -->
    <style name="PillPrimary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:paddingHorizontal">22dp</item>
        <item name="android:background">@drawable/pill_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">#03151B</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="PillOk" parent="PillPrimary">
        <item name="android:background">@drawable/pill_ok</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="PillDanger" parent="PillPrimary">
        <item name="android:background">@drawable/pill_danger</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>

    <!-- Píldora seleccionable (modos de visión) -->
    <style name="ModeButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginVertical">3dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:background">@drawable/pill_ghost</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="FlipButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:background">@drawable/pill_ghost</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">#FFE082</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:background">@drawable/icon_ghost</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="HudValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">7dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
